<Page
    x:Class="CloudGI.Host.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28" MaxWidth="760" Spacing="24">
      <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="24">
        <StackPanel Spacing="16">
          <TextBlock Text="游戏启动" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBox Header="游戏目录或可执行文件"
                   Text="{x:Bind ViewModel.GamePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.AutomationId="GamePathTextBox"
                   IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                   PlaceholderText="选择 YuanShen.exe / GenshinImpact.exe，或粘贴游戏目录" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="选择文件" Click="BrowseFile_Click" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
            <Button Content="选择目录" Click="BrowseFolder_Click" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
          </StackPanel>
          <CheckBox Content="全屏启动" IsChecked="{x:Bind ViewModel.Fullscreen, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
          <TextBlock Text="手机 UI 请在首页切换，修改将在下次启动游戏时生效。"
                     TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBox Header="自定义启动参数（可留空）"
                   Text="{x:Bind ViewModel.LaunchArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.AutomationId="LaunchArgumentsTextBox"
                   IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                   TextWrapping="Wrap" MinHeight="72" MaxLength="8192"
                   PlaceholderText="例如：-screen-width 1280 -screen-height 720" />
          <TextBlock Text="全屏由上方选项决定，手机 UI 由首页开关决定；旧版平台参数会被移除，其余参数保留。"
                     TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="保存设置" Click="Save_Click"
                    AutomationProperties.AutomationId="SaveSettingsButton"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="24">
        <StackPanel Spacing="16">
          <TextBlock Text="手机串流" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="{x:Bind Streaming.StateText, Mode=OneWay}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind Streaming.Detail, Mode=OneWay}" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBox Header="串流主机名称" Text="{x:Bind Streaming.HostName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{x:Bind Streaming.IsNotBusy, Mode=OneWay}" MaxLength="128" />
          <TextBlock Text="修改名称会重新启动串流服务，当前连接将断开。" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <Button Content="保存主机名称" Click="SaveStreamingName_Click" IsEnabled="{x:Bind Streaming.IsNotBusy, Mode=OneWay}" />
          <TextBlock Text="{x:Bind Streaming.NetworkText, Mode=OneWay}" TextWrapping="Wrap" />
          <Button Content="允许局域网连接" Click="EnableNetwork_Click" IsEnabled="{x:Bind Streaming.IsNotBusy, Mode=OneWay}" />
          <TextBlock Text="在手机 Moonlight 中选择此主机发起配对，然后在这里输入手机显示的 PIN。" TextWrapping="Wrap" />
          <ComboBox Header="等待配对的设备" ItemsSource="{x:Bind Streaming.PendingPairings}" DisplayMemberPath="Label"
                    SelectedItem="{x:Bind Streaming.SelectedPairing, Mode=TwoWay}" HorizontalAlignment="Stretch"
                    IsEnabled="{x:Bind Streaming.IsNotBusy, Mode=OneWay}" />
          <TextBox Header="四位 PIN" Text="{x:Bind Streaming.Pin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   InputScope="Number" MaxLength="4" IsEnabled="{x:Bind Streaming.IsNotBusy, Mode=OneWay}" />
          <Button Content="配对" Click="Pair_Click" IsEnabled="{x:Bind Streaming.CanPair, Mode=OneWay}" />
          <InfoBar IsOpen="{x:Bind Streaming.IsStatusOpen, Mode=OneWay}" IsClosable="False"
                   Severity="{x:Bind Streaming.StatusSeverity, Mode=OneWay}"
                   Message="{x:Bind Streaming.StatusMessage, Mode=OneWay}" />
        </StackPanel>
      </Border>
      <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}" IsClosable="False"
               Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
               Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </StackPanel>
  </ScrollViewer>
</Page>
