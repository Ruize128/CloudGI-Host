<Page
    x:Class="CloudGI.Host.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28" MaxWidth="760" Spacing="24">
      <StackPanel Spacing="8">
        <TextBlock Text="CloudGI Host" Style="{StaticResource TitleTextBlockStyle}" />
      </StackPanel>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Text="手机串流" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="{x:Bind Streaming.StateText, Mode=OneWay}" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="StreamingStateText" />
          <TextBlock Text="{x:Bind Streaming.Detail, Mode=OneWay}" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="配对与局域网连接请打开设置。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <Button Content="重新启动串流服务" Click="RestartStreaming_Click"
                  IsEnabled="{x:Bind Streaming.IsNotBusy, Mode=OneWay}" />
        </StackPanel>
      </Border>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="24">
        <StackPanel Spacing="16">
          <TextBlock Text="原神" Style="{StaticResource SubtitleTextBlockStyle}" />
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.GameStateText, Mode=OneWay}"
                       AutomationProperties.AutomationId="GameRuntimeStateText"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.GameStateDetail, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <TextBlock Text="游戏文件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="{x:Bind ViewModel.GamePath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="启动参数" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="{x:Bind ViewModel.Arguments, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <ToggleSwitch Header="以手机 UI 启动" OnContent="开启" OffContent="关闭"
                        IsOn="{x:Bind ViewModel.TouchscreenMode, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanChangeTouchscreenMode, Mode=OneWay}"
                        Toggled="TouchscreenMode_Toggled"
                        AutomationProperties.AutomationId="MobileUiToggle" />
          <TextBlock Text="自动保存，电脑和手机发起的下次启动均使用此选项；已运行的游戏需要退出后重新启动。"
                     TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="{x:Bind ViewModel.LaunchButtonText, Mode=OneWay}" Click="LaunchGame_Click"
                    AutomationProperties.AutomationId="LaunchGameButton"
                    IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button Content="打开设置" Click="OpenSettings_Click" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
          </StackPanel>
        </StackPanel>
      </Border>
      <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}" IsClosable="False"
               Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
               Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
      <Expander Header="关于此主机" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12">
          <TextBlock Text="{x:Bind ViewModel.Version}" />
          <TextBlock Text="{x:Bind ViewModel.Platform}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind ViewModel.Runtime}" />
          <TextBlock Text="WinUI 3 · Windows 11" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Page>
