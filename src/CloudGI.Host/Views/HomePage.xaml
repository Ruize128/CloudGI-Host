<Page
    x:Class="CloudGI.Host.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28" MaxWidth="760" Spacing="24">
      <StackPanel Spacing="8">
        <TextBlock Text="CloudGI Host" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="配置并启动这台电脑上的原神。"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1" CornerRadius="8" Padding="24">
        <StackPanel Spacing="16">
          <TextBlock Text="原神" Style="{StaticResource SubtitleTextBlockStyle}" />
          <TextBlock Text="游戏文件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="{x:Bind ViewModel.GamePath, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <TextBlock Text="已保存的启动参数" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="{x:Bind ViewModel.Arguments, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="启动游戏" Click="LaunchGame_Click"
                    AutomationProperties.AutomationId="LaunchGameButton"
                    IsEnabled="{x:Bind ViewModel.CanLaunch, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button Content="打开设置" Click="OpenSettings_Click" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
          </StackPanel>
        </StackPanel>
      </Border>
      <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}" IsClosable="False"
               Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
               Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
      <Expander Header="关于此主机" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="12">
          <TextBlock Text="{x:Bind ViewModel.Version}" />
          <TextBlock Text="{x:Bind ViewModel.Platform}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind ViewModel.Runtime}" />
          <TextBlock Text="WinUI 3 · Windows 11" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Page>
